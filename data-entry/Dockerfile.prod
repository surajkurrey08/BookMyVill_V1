# Production image: static build served by nginx (used by Kubernetes).
# API_BASE_URL is baked in at build time, e.g.
#   docker build -f Dockerfile.prod --build-arg API_BASE_URL=https://api.bookmyvilla.online -t bookmyvilla/data-entry .
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG API_BASE_URL=https://api.bookmyvilla.online
ENV VITE_API_BASE_URL=${API_BASE_URL} VITE_API_URL=${API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine
RUN printf 'server {\n  listen 8080;\n  root /usr/share/nginx/html;\n  index index.html;\n  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }\n  location = /healthz { access_log off; return 200 "ok"; }\n  location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }\n}\n' > /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
