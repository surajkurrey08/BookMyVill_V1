SERVICE_NAME=payment-service
PORT=2107
NODE_ENV=production
# Shared database (legacy-shared services, and the default for every service)
MONGODB_URI=
# Own database of payment-service. Empty = use MONGODB_URI's database (current data).
# Target after copying data (scripts/copy-service-data.js): bookmyvilla_payments
PAYMENT_MONGODB_URI=
PAYMENT_DB_NAME=
JWT_SECRET=
# Shared secret for /internal service-to-service calls (same value in every service)
INTERNAL_SERVICE_TOKEN=
RABBITMQ_URL=amqp://rabbitmq:5672
REDIS_URL=redis://redis:6379
