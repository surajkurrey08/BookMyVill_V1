# MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/hillstation

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key

# Port to run the server on (default: 2001)
PORT=2001

# Optional directory for admin-managed website hero images
HERO_UPLOAD_DIR=./uploads/site-heroes

# Razorpay credentials for payment integration (optional for local testing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Demo mobile OTP (non-production only): when true, the 6-digit sign-up OTP is
# shown on the login screen instead of being sent by SMS (no SMS gateway yet)
ALLOW_DEMO_OTP=true
