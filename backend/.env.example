# MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/hillstation

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key

# Port to run the server on (default: 2001)
PORT=2001

# Optional directory for admin-managed website hero images
HERO_UPLOAD_DIR=./uploads/site-heroes

# Optional property media directory (keep on persistent storage)
PROPERTY_MEDIA_DIR=./uploads/properties
# Production API origin used in property media URLs (omit for local development)
# PUBLIC_API_URL=https://api.bookmyvilla.online

# Optional Cloudinary storage for property photos and videos.
# Configure all three credentials; complete credentials enable Cloudinary automatically.
# Production deployment reads these from GitHub Actions repository secrets.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_FOLDER=bookmyvilla/properties

# Razorpay credentials for payment integration (optional for local testing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Indian SMS gateway credentials (OTP template is registered with DLT)
SMS_API_URL=https://your-sms-gateway.example/smsstatuswithid.aspx
SMS_USERNAME=your_gateway_username
SMS_PASSWORD=your_gateway_password
SMS_SENDER_ID=BKMYVA
SMS_TEMPLATE_ID=1777179206833227479
# Optional if your provider requires the Principal Entity ID in each request
# SMS_PE_ID=your_dlt_principal_entity_id

# Microservices (see ../.env.example for every option)
# RABBITMQ_URL=amqp://127.0.0.1:5672   # unset = in-process event bus
# REDIS_URL=redis://127.0.0.1:6379      # unset = in-process holds/cache (single process only)
# INTERNAL_SERVICE_TOKEN=               # shared secret for /internal service calls
# Per-service databases (unset = this MONGODB_URI database):
# REVIEW_DB_NAME=bookmyvilla_reviews  COUPON_DB_NAME=bookmyvilla_coupons  PAYMENT_DB_NAME=bookmyvilla_payments
# NOTIFICATION_DB_NAME=bookmyvilla_notifications  SEARCH_DB_NAME=bookmyvilla_search
