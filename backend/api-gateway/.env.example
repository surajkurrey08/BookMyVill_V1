PORT=2001
NODE_ENV=production
JWT_SECRET=
REDIS_URL=redis://redis:6379
# Internal service addresses (defaults: http://<service-name>:<port>).
# For local runs without Docker: SERVICE_HOST=localhost
SERVICE_HOST=
GATEWAY_CRITICAL_SERVICES=auth-service,user-service,villa-service,booking-service,payment-service
GATEWAY_RATE_LIMIT_PER_MINUTE=600
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=60
GATEWAY_UPSTREAM_TIMEOUT_MS=60000
CORS_ORIGINS=
