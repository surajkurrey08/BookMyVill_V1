# BookMyVilla — environment overview (no real values here).
# Backend services read backend/.env; each app/service folder has its own .env.example.

# --- Backend (all services and the API Gateway) ---
NODE_ENV=production
MONGODB_URI=
JWT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CORS_ORIGINS=
PUBLIC_API_URL=https://api.bookmyvilla.online
RABBITMQ_URL=amqp://rabbitmq:5672
REDIS_URL=redis://redis:6379
# Shared secret every service sends on /internal calls (long random string).
INTERNAL_SERVICE_TOKEN=
# How long payment verify waits for booking-service to confirm (ms).
PAYMENT_CONFIRM_WAIT_MS=8000
# Seconds a service caches an account identity from user-service (0 = no cache).
IDENTITY_CACHE_SECONDS=30
LOG_LEVEL=info

# --- Per-service databases (independent services) ---
# Unset = the shared MONGODB_URI database (where the data is today).
# To move a service: copy its data (backend/scripts/copy-service-data.js), then set
# its DB name (and URI if it lives on another cluster). Nothing is moved automatically.
PAYMENT_MONGODB_URI=
PAYMENT_DB_NAME=
NOTIFICATION_MONGODB_URI=
NOTIFICATION_DB_NAME=
SEARCH_MONGODB_URI=
SEARCH_DB_NAME=
REVIEW_MONGODB_URI=
REVIEW_DB_NAME=
COUPON_MONGODB_URI=
COUPON_DB_NAME=
# Testing only — shows the sign-up OTP on screen instead of sending an SMS.
ALLOW_DEMO_OTP=false

# --- API Gateway (public backend entry, keep 2001) ---
GATEWAY_PORT=2001
GATEWAY_RATE_LIMIT_PER_MINUTE=600
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=60

# --- Web apps (build time) ---
VITE_API_BASE_URL=https://api.bookmyvilla.online

# --- Monitoring (docker-compose.monitoring.yaml) ---
GRAFANA_ADMIN_PASSWORD=
