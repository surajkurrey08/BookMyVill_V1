# Backend API Base URL
VITE_API_URL=http://localhost:2001
VITE_API_BASE_URL=http://localhost:2001/api

VITE_APP_NAME=BookMyVilla

# Google Maps Platform API Key (Requires Maps JavaScript API and Places API enabled in Google Cloud Console)
# Restrict to HTTP referrers in Google Cloud Console: http://localhost:*, https://your-domain.com/*
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Optional Map ID for the property location map (falls back to Google's DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=

# Payment Gateway
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
